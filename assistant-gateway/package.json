{
  "name": "smore-assistant-gateway",
  "version": "1.0.0",
  "description": "Secure VPS API gateway for the Smore Assistant. Verifies Firebase Auth ID tokens, reads the caller's own Firestore data, and answers finance questions with Gemini on the Spark plan (no Firebase Cloud Functions).",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "smore",
    "firebase",
    "firestore",
    "gemini",
    "gateway",
    "finance"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ]
  }
}
