# ============================================================================
# Smore Assistant Gateway — environment template
#
# Copy this file to `.env` and fill in REAL values. Never commit `.env`.
# Every secret below is verified as MISSING/placeholder before the server runs,
# and none of these values are ever written into frontend files.
# ============================================================================

# ---- Server ----------------------------------------------------------------
# Port the gateway listens on. Default 8080.
PORT=8080

# Comma-separated list of allowed browser origins for CORS.
# Example: http://localhost:5500,https://your-hosting-domain.firebaseapp.com
# No spaces. Requests from any other origin are rejected.
ALLOWED_ORIGINS=http://localhost:5500

# ---- Firebase Admin (server-side, read-only) --------------------------------
# Path to the Firebase service-account JSON file you downloaded from the
# Firebase console (Project settings > Service accounts > Generate new
# private key). This file is used ONLY on the VPS to verify auth ID tokens and
# read Firestore. Keep the file OUTSIDE the repo and never commit it.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/smore-6464b-firebase-adminsdk-xxxx.json

# The Firebase project ID (used for Firestore and token verification).
FIREBASE_PROJECT_ID=smore-6464b

# ---- Gemini API ------------------------------------------------------------
# Secret key for the Gemini API (Google AI Studio). Stored ONLY as a VPS
# environment variable. Never commit it and never put it in frontend files.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Gemini model to use. Reasonable defaults: gemini-1.5-flash,
# gemini-1.5-pro, gemini-2.0-flash. Blank falls back to gemini-1.5-flash.
GEMINI_MODEL=gemini-1.5-flash

# Maximum output tokens Gemini is allowed to generate per answer. Guards cost.
GEMINI_MAX_OUTPUT_TOKENS=800

# ---- Rate limiting ----------------------------------------------------------
# Maximum assistant requests per IP per window. Defaults 30 per 15 minutes.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_PER_IP=30
